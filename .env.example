# Copy to .env for local overrides (never commit .env). All settings are
# validated at start-up; see src/config.ts for the full list.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Evidence source: index (built by `pnpm ingest`), sections (bundled Companies
# Act, 2013 with connected provisions and amendment history) or azure_search.
RETRIEVER=index
INDEX_PATH=data/index/legal-bot.sqlite
# BM25 + embedding search merged with Reciprocal Rank Fusion (needs
# scripts/build-embeddings.ts and AZURE_OPENAI_EMBEDDING_DEPLOYMENT).
HYBRID_RETRIEVAL=false
SECTIONS_PATH=data/sections/companies-act-2013.sections.json
HISTORY_PATH=data/history/companies-act-2013.history.json
# primary_source_verified (strict, default) or secondary_corroborated
HISTORY_MIN_DATE_EVIDENCE=primary_source_verified

# Answer writing: extract (no model, free) or azure_openai (billable per token).
COMPOSER=extract
VERIFICATION=deterministic
ANSWER_TIMEOUT_MS=60000
# Selective answering: verified answers below this confidence (0-1) return sources only. 0 disables.
# Unset = 0.7 with COMPOSER=azure_openai, otherwise 0.
# CONFIDENCE_THRESHOLD=0.7

# Azure OpenAI (only for COMPOSER=azure_openai or RETRIEVER=azure_search).
# Authentication uses Microsoft Entra ID (DefaultAzureCredential: `az login`
# locally, managed identity in Azure). No API key is stored.
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_GENERATION_DEPLOYMENT=<chat-deployment>
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<embedding-deployment>
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
# AZURE_SEARCH_INDEX=<index-name>

# API protection. Production refuses to start without API_KEYS unless
# PUBLIC_DEMO=true. Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# API_KEYS=<key-1>,<key-2>
PUBLIC_DEMO=false
# CORS_ORIGINS=https://your-frontend.example
ASK_RATE_LIMIT_PER_MINUTE=20
# Set to true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
