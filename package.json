{
  "name": "legal-bot",
  "version": "1.0.0",
  "description": "Retrieval-augmented question answering over Indian statutes, with claim-level answer verification and a frozen evaluation harness.",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "ingest": "tsx scripts/ingest.ts",
    "ask": "tsx scripts/ask.ts",
    "eval": "tsx scripts/evaluate-legal-pipeline.ts",
    "eval:verifier": "tsx scripts/evaluate-claim-verifier.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@azure/identity": "4.13.2",
    "@azure/search-documents": "13.0.0",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.1",
    "openai": "7.9.0",
    "pdfjs-dist": "6.3.289",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.4",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
